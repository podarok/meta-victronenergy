From cd2be978a1eedf701ec055bcaeb0aa1c5f0372e5 Mon Sep 17 00:00:00 2001
From: nmbath <mark@baggywrinkle.co.uk>
Date: Tue, 22 Sep 2026 21:33:00 +0100
Subject: [PATCH] nginx: enlarge exchange request zone

nginx 1.24 rejects a 64 KiB request zone on the target because it cannot
hold the required state. Use 128 KiB, which validates on Venus OS v3.80.
---
 packaging/venus/nginx-http.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packaging/venus/nginx-http.conf b/packaging/venus/nginx-http.conf
index 004d45f..45334b5 100644
--- a/packaging/venus/nginx-http.conf
+++ b/packaging/venus/nginx-http.conf
@@ -3,4 +3,4 @@ upstream venus_exchange {
     server unix:/run/venus-exchange/http.sock;
 }

-limit_req_zone $binary_remote_addr zone=venus_exchange_requests:64k rate=5r/s;
+limit_req_zone $binary_remote_addr zone=venus_exchange_requests:128k rate=5r/s;
--
2.43.0
